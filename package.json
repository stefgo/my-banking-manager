{
  "name": "my-banking-manager",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "description": "My Banking Manager: self-hosted home banking",
  "workspaces": [
    "shared",
    "server",
    "connectors/fints",
    "clients/web"
  ],
  "engines": {
    "node": ">=26"
  },
  "packageManager": "npm@11.20.0",
  "scripts": {
    "dev:server": "npm run dev -w server",
    "dev:web": "npm run dev -w clients/web",
    "dev:fints": "npm run dev -w connectors/fints",
    "dev:full": "npm run dev:full -w server",
    "build": "npm run build -w shared && npm run build -w server && npm run build -w connectors/fints && npm run build -w clients/web",
    "start": "npm run start -w server",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck -w shared && npm run typecheck -w server && npm run typecheck -w connectors/fints && npm run typecheck -w clients/web",
    "lint": "eslint .",
    "contracts": "tsx --conditions=development scripts/contracts.ts",
    "contracts:check": "tsx --conditions=development scripts/contracts.ts --check",
    "blz": "tsx scripts/blz.ts",
    "screenshots": "tsx --conditions=development scripts/screenshots/capture.ts",
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "playwright": "^1.65.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "better-sqlite3-multiple-ciphers": false,
    "esbuild": false,
    "fsevents": false
  }
}
