{
  "name": "@mbm/server",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "MBM_FINTS_SOCKET=${MBM_FINTS_SOCKET:-../.run/fints.sock} tsx watch --tsconfig tsconfig.dev.json --conditions=development src/index.ts",
    "dev:full": "MBM_FINTS_EMBEDDED=1 tsx watch --env-file-if-exists=../.env --tsconfig tsconfig.dev.json --conditions=development src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --customConditions development"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/static": "^10.1.10",
    "@fastify/websocket": "^11.3.7",
    "@mbm/shared": "*",
    "better-sqlite3-multiple-ciphers": "^13.0.3",
    "fastify": "^5.12.8",
    "pino": "^10.4.0",
    "umzug": "^3.8.3",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@mbm/connector-fints": "*",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.2.0"
  }
}
