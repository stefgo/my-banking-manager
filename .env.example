# Copy to .env (never committed). Read by `docker compose` and by the local development start
# (npm run dev:fints, npm run bank-info -w connectors/fints, npm run eb-info -w connectors/enablebanking,
# VS Code tasks and debug configurations).

# Enable Banking, only for the local tool eb-info (npm run eb-info -w connectors/enablebanking):
# application ID and the path of its private key (.pem), relative paths from this folder. Best kept
# outside the repository with chmod 600; *.pem files are ignored by git anyway.
MBM_EB_APP_ID=
MBM_EB_KEY=

# FinTS product registration number (fints.org). Leave empty with the official mbm-server-full
# images, they carry one. The image mbm-fints (compose.split.yaml) never carries one: there, and
# for anyone who builds or modifies MBM, register your own. Without any, no bank is contacted.
MBM_FINTS_PRODUCT_ID=

# Official images instead of building yourself. Empty: docker compose builds the images locally.
# compose.yaml (one container), e.g. ghcr.io/<owner>/mbm-server-full:1.1.0
MBM_IMAGE_SERVER_FULL=
# compose.split.yaml (separate containers), e.g. ghcr.io/<owner>/mbm-server:1.1.0, …/mbm-fints:1.1.0
# and …/mbm-enablebanking:1.1.0
MBM_IMAGE_SERVER=
MBM_IMAGE_FINTS=
MBM_IMAGE_ENABLEBANKING=

# 1 = the connector prints the structure of each bank message to stderr (no contents), for diagnosis.
MBM_FINTS_TRACE=
